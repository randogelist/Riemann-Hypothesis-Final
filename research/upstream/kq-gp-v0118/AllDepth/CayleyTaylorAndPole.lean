import AllDepth.PowerSeriesRootTest

/-!
# All-depth Cayley Taylor kernel and actual-Theta pole interface

This is a NON-dyadic bridge. We prove the finite geometric Taylor-remainder
identity, the exact behavior of partial jets at a reciprocal Cayley pole,
and a noncancellation obstruction for a positive principal residue.

The actual-ξ Taylor identification and analytic continuation across the
punctured Cayley disk are made explicit *as goals*; they are not axioms
or previously proven analytic facts.

Warning: the inherited `actualThetaCayleyObservable` uses `Option.none` when
Theta vanishes. That endpoint by itself does not prove a genuine
nonremovable pole: multiplicity, logarithmic derivative and noncancellation
must be addressed analytically. In particular r=0 must be regularized.
-/

namespace KQGPBKQRHilbert.AllDepth

noncomputable section

/-- Finite Taylor polynomial generated by the single Cayley channel q.
    Recursion gives `q + q^2*r + ... + q^(n+1)*r^n`. -/
def cayleyPartial (q r : ℝ) : ℕ → ℝ
  | 0 => q
  | n + 1 => q + (r * q) * cayleyPartial q r n

/-- Exact denominator-clearing identity for EVERY finite order. -/
theorem cayleyPartial_denominator (q r : ℝ) (n : ℕ) :
    (1 - r * q) * cayleyPartial q r n =
      q - q * (r * q) ^ (n + 1) := by
  induction n with
  | zero =>
      simp only [cayleyPartial, zero_add, pow_one]
      ring
  | succ n ih =>
      calc
        (1 - r * q) * cayleyPartial q r (n + 1) =
            (1 - r * q) * (q + (r * q) * cayleyPartial q r n) := rfl
        _ = (1 - r * q) * q +
              (r * q) * ((1 - r * q) * cayleyPartial q r n) := by ring
        _ = (1 - r * q) * q +
              (r * q) * (q - q * (r * q) ^ (n + 1)) := by rw [ih]
        _ = q - q * (r * q) ^ ((n + 1) + 1) := by
              rw [pow_succ (r * q) (n + 1)] <;> ring

/-- The exact all-depth Taylor remainder, with NO limiting assumption. -/
theorem cayley_geometric_remainder
    (q r : ℝ) (n : ℕ) (hden : 1 - r * q ≠ 0) :
    q / (1 - r * q) = cayleyPartial q r n +
      q * (r * q) ^ (n + 1) / (1 - r * q) := by
  rw [div_eq_iff hden]
  calc
    q = (1 - r * q) * cayleyPartial q r n +
          q * (r * q) ^ (n + 1) := by
        rw [cayleyPartial_denominator] <;> ring
    _ = (cayleyPartial q r n +
          q * (r * q) ^ (n + 1) / (1 - r * q)) *
          (1 - r * q) := by
        field_simp [hden] <;> ring

/-- At its reciprocal radius every finite partial jet equals `(n+1)*q`.
    This is an unconditional algebraic divergence certificate for q>0. -/
theorem cayleyPartial_at_reciprocal
    (q : ℝ) (hq : q ≠ 0) (n : ℕ) :
    cayleyPartial q (1 / q) n = ((n + 1 : ℕ) : ℝ) * q := by
  have hqr : (1 / q) * q = (1 : ℝ) := by field_simp [hq]
  induction n with
  | zero => simp [cayleyPartial]
  | succ n ih =>
      calc
        cayleyPartial q (1 / q) (n + 1) =
            q + ((1 / q) * q) * cayleyPartial q (1 / q) n := rfl
        _ = q + (((n + 1 : ℕ) : ℝ) * q) := by rw [hqr, ih] <;> ring
        _ = (((n + 1 + 1 : ℕ) : ℝ) * q) := by push_cast <;> ring

/-- An actual off-line Cayley channel has a positive principal numerator
    whenever its local logarithmic-derivative multiplicity is positive. -/
theorem positive_principal_numerator
    (q w : ℝ) (hq : 0 < q) (hw : 0 < w) :
    0 < w * q := mul_pos hw hq

/-- Algebraic noncancellation: at `r=1/q`, a finite regular remainder
    cannot cancel a strictly positive Laurent principal numerator.
    The analytic task is to derive the cross-multiplied equation from the
    *actual* Theta and its regularized Taylor continuation. -/
theorem positive_pole_cannot_be_cross_multiplied
    (q w F H : ℝ) (hq : 0 < q) (hw : 0 < w) :
    ¬ ((1 - (1 / q) * q) * F =
        w * q + (1 - (1 / q) * q) * H) := by
  have hq0 : q ≠ 0 := ne_of_gt hq
  have hd : (1 / q) * q = (1 : ℝ) := by field_simp [hq0]
  intro heq
  rw [hd] at heq
  simp only [sub_self, zero_mul, add_zero] at heq
  exact (ne_of_gt (mul_pos hw hq)) heq.symm

/-- The actual-ξ candidate Taylor series, defined for every real `a,r`.
    Summability follows from `ActualXiSubexponential` only for |r|<1. -/
def xiCayleyTaylor (a r : ℝ) : ℝ :=
  ∑' n : ℕ, NativeSoloboloNegativity.xiWidderMoment a n * r ^ n

/-- Under the still-open subexponential envelope, the actual-ξ radial
    series converges even at the canonical interior radius of any
    hypothetical off-line zero. This is the precise analytic setting in
    which a genuine positive-residue pole would be contradictory. -/
theorem xiTaylor_abs_summable_at_offline_radius
    (T : NativeSolobolo.CenteredThetaData)
    (hsub : ActualXiSubexponential)
    (z : T.geometry.Zero) (hz : T.geometry.beta z ≠ 0) :
    Summable (fun n : ℕ =>
      |NativeSoloboloNegativity.xiWidderMoment (T.geometry.anchor z) n *
        (T.geometry.radius z) ^ n|) := by
  have hr :=
    NativeSolobolo.Derivations.Geometry.OFFLINE_ZERO_GIVES_INTERIOR_RADIUS
      T.geometry z hz
  exact actual_xi_radial_absolute_summable hsub
    (T.geometry.anchor z) (T.geometry.radius z)
    (NativeSolobolo.Derivations.Geometry.ANCHOR_POSITIVE T.geometry z)
    (le_of_lt hr.1) hr.2

/-- B1 (OPEN): germ equality with the *regularized* actual Theta Cayley
    observable, for small positive `r`. The existing Option-valued
    observable is not evaluated at the degenerate endpoint `r=0` here. -/
def ActualXiTaylorGerm (T : NativeSolobolo.CenteredThetaData) : Prop :=
  ∀ a : ℝ, 0 < a →
    ∃ δ : ℝ, 0 < δ ∧
      ∀ r : ℝ, 0 < r → r < δ →
        ∃ v : ℂ,
          (NativeSolobolo.actualThetaCayleyObservable T).eval a r = some v ∧
          v = (∑' n : ℕ,
            (NativeSoloboloNegativity.xiWidderMoment a n : ℂ) *
              (r : ℂ) ^ n)

/-- B2 (OPEN): the analytically continued, cross-multiplied Laurent
    identity for every hypothetical off-line zero, *conditional on* a
    convergent ξ-Widder disk series. Positive residue `w*q` is required.

    Proving this requires genuine entire-Theta local factorization,
    integer zero multiplicity, germ identification, and a complex identity
    theorem. It is NOT inferred merely from the `Option.none` endpoint. -/
def ActualXiPoleCrossing
    (T : NativeSolobolo.CenteredThetaData) : Prop :=
  ∀ z : T.geometry.Zero, T.geometry.beta z ≠ 0 →
    SubexponentialAt NativeSoloboloNegativity.xiWidderMoment
      (T.geometry.anchor z) →
    ∃ w h : ℝ, 0 < w ∧
      (1 - T.geometry.radius z * T.geometry.cayleyQ z) *
          xiCayleyTaylor (T.geometry.anchor z) (T.geometry.radius z) =
        w * T.geometry.cayleyQ z +
          (1 - T.geometry.radius z * T.geometry.cayleyQ z) * h

/-- Actual ξ subexponential growth contradicts the fully justified
    positive-residue crossing identity at any off-line zero. No 2^k. -/
theorem subexp_and_positive_pole_crossing_imply_centered_RH
    (T : NativeSolobolo.CenteredThetaData)
    (hcross : ActualXiPoleCrossing T)
    (hsub : ActualXiSubexponential) :
    NativeSolobolo.RiemannHypothesis T.geometry := by
  by_contra hnot
  obtain ⟨z, hz⟩ :=
    NativeSolobolo.Derivations.Geometry.NOT_RH_GIVES_OFFLINE_ZERO
      T.geometry hnot
  have ha : 0 < T.geometry.anchor z :=
    NativeSolobolo.Derivations.Geometry.ANCHOR_POSITIVE T.geometry z
  have hq : 0 < T.geometry.cayleyQ z :=
    lt_trans (by norm_num : (0 : ℝ) < 1)
      (NativeSolobolo.Derivations.Geometry.CAYLEY_Q_GT_ONE T.geometry z hz)
  obtain ⟨w, h, hw, heq⟩ := hcross z hz (hsub _ ha)
  have hrq : T.geometry.radius z * T.geometry.cayleyQ z = 1 := by
    simpa [mul_comm] using
      (NativeSolobolo.Derivations.Geometry.CAYLEY_Q_MUL_RADIUS T.geometry z)
  have hden : 1 - T.geometry.radius z * T.geometry.cayleyQ z = 0 := by
    rw [hrq] <;> ring
  rw [hden] at heq
  simp only [zero_mul, add_zero] at heq
  exact (ne_of_gt (positive_principal_numerator _ _ hq hw)) heq.symm

/-- The literal Mathlib RH follows only with explicit actual-zero coverage. -/
theorem subexp_and_positive_pole_crossing_imply_Mathlib_RH
    (T : NativeSolobolo.CenteredThetaData)
    (hcoverage : ActualXiZeroCoverage T.geometry)
    (hcross : ActualXiPoleCrossing T)
    (hsub : ActualXiSubexponential) :
    _root_.RiemannHypothesis :=
  hcoverage (subexp_and_positive_pole_crossing_imply_centered_RH T hcross hsub)

end
end KQGPBKQRHilbert.AllDepth
