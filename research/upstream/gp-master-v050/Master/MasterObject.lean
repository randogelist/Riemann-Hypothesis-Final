import Literature.Zhang2023

namespace RHGPBKQR

/--
!! Completed GP normalization at the distinguished `u = 1` slice.
At the core-only level this is the normalized coefficient object whose analytic
realization is `G(1,s)=Xi(s)`.
-/
def GPCompletedXiSliceCoeff : Nat → Int :=
  ZhangCenteredXiCoeff

/-- ! Canonical centered R jet induced by the completed GP slice. -/
def CanonicalGPCenteredRJet : Nat → Int :=
  ReducedXiLogJetToCenteredRJet (ReducedXiLogJetOf GPCompletedXiSliceCoeff)

/-- ! Canonical GP raw moment sequence. -/
def CanonicalGPRawMoment : Nat → Int :=
  CenteredRJetToRawMoment CanonicalGPCenteredRJet

/-- !! Canonical GP/Zhang normalized moment sequence. -/
def CanonicalGPNormalizedCoeff : Nat → Int :=
  ZhangScaleNormalize CanonicalGPRawMoment

/--
!!! MASTER OBJECT
One object carrying the selected GP/BKQR/Hopf/local-Q/u-gauge data.

`modeVec` represents contour Fourier modes `P_m Psi`.
`normSq` is the local-Q/BKQR energy functional.
`leftBranch` and `rightBranch` represent the two Hopf branches, morally
`T^(1/2)` and `(I-T)^(1/2)`.
`energyVec n k` represents `X_{n,k}`.
-/
structure MasterObject where
  Q : Type
  normSq : Q → Nat
  readout : Q → Int
  masterState : Q

  modeVec : Nat → Q
  rhSlice : Int
  shiftedCoeff : Nat → Int
  zeroMode : readout (modeVec 0) = rhSlice
  modeShift : ∀ m : Nat, readout (modeVec m) = shiftedCoeff m

  leftBranch : Q → Q
  rightBranch : Q → Q
  binaryIsometry : ∀ x : Q,
    normSq x = normSq (leftBranch x) + normSq (rightBranch x)

  energyVec : Nat → Nat → Q
  energyOrigin : energyVec 0 0 = masterState
  energyLeft : ∀ n k : Nat,
    energyVec (n + 1) k = leftBranch (energyVec n k)
  energyRight : ∀ n k : Nat,
    energyVec n (k + 1) = rightBranch (energyVec n k)

  momentBoundary : ∀ n : Nat,
    Int.ofNat (normSq (energyVec n 0)) = CanonicalGPNormalizedCoeff n

namespace MasterObject

/-- ! Natural-valued energy lattice generated by the master state. -/
def energy (M : MasterObject) (n k : Nat) : Nat :=
  M.normSq (M.energyVec n k)

/-- ! Integer image of the master energy lattice. -/
def energyInt (M : MasterObject) (n k : Nat) : Int :=
  Int.ofNat (M.energy n k)

/-- ! Finite transverse local-Q energy, excluding the zero Fourier mode. -/
def qGammaPrefix (M : MasterObject) : Nat → Nat
  | 0 => 0
  | N + 1 => qGammaPrefix M N + M.normSq (M.modeVec (N + 1))

end MasterObject
end RHGPBKQR
