import Anchors.ActualXiTierACore

namespace GPBKQRAnchoring01

open GPBKQRTierA
open RHGPBKQR
open RHGPBKQR.Frontier
open RHGPBKQR.Derivations

/-!
# Concrete finite Tier-A Xi calibration

Unlike `TierAAnchoredPackage`, the structure below does not contain an abstract
Hausdorff, Pascal, energy, trace-resolvent, or `OurFrontier` field.  It contains
only explicit finite Tier-A probability kernels, concrete real feature vectors,
and finite-jet agreement with the actual Zhang-normalized Xi coefficient
sequence.  Every finite-stage Hausdorff cell is then derived from the already
proved Tier-A kernel identities.
-/

/-- A finite positive-kernel approximation of an integer coefficient sequence.
At stage `Y` the moments are generated by an explicit finite probability model
and one real feature vector.  Every finite target jet is eventually reproduced
exactly after coercion to `ℝ`. -/
structure XiFiniteKernelApproxData (c : ℕ → ℤ) where
  dim : ℕ → ℕ
  model : ∀ Y : ℕ, FiniteProbability (dim Y)
  state : ∀ Y : ℕ, Fin (dim Y) → ℝ
  finiteJet : ∀ cutoff : ℕ, ∃ Y0 : ℕ,
    ∀ Y : ℕ, Y0 ≤ Y → ∀ n : ℕ, n ≤ cutoff →
      weightedMoment (model Y) (state Y) n = (c n : ℝ)

/-- A real Hausdorff cell depends only on the coefficient window
`n, ..., n+k`. -/
theorem REAL_HDIFF_CONGR_UP_TO
    {a b : ℕ → ℝ} (cutoff n k : ℕ)
    (h : ∀ j : ℕ, j ≤ cutoff → a j = b j)
    (hbound : n + k ≤ cutoff) :
    hdiff a n k = hdiff b n k := by
  induction k generalizing n with
  | zero =>
      exact h n (by omega)
  | succ k ih =>
      calc
        hdiff a n (k + 1) = hdiff a n k - hdiff a (n + 1) k := rfl
        _ = hdiff b n k - hdiff b (n + 1) k := by
          rw [ih n (by omega), ih (n + 1) (by omega)]
        _ = hdiff b n (k + 1) := rfl

/-- Coercing an integer sequence to `ℝ` commutes with signed Hausdorff finite
differences. -/
theorem HDIFF_INT_CAST (c : ℕ → ℤ) :
    ∀ n k : ℕ,
      hdiff (fun j => (c j : ℝ)) n k =
        (HausdorffDiff c n k : ℝ) := by
  intro n k
  induction k generalizing n with
  | zero => rfl
  | succ k ih =>
      change
        hdiff (fun j => (c j : ℝ)) n k -
            hdiff (fun j => (c j : ℝ)) (n + 1) k =
          ((HausdorffDiff c n k - HausdorffDiff c (n + 1) k : ℤ) : ℝ)
      rw [ih n, ih (n + 1)]
      norm_num

/-- Explicit finite Tier-A kernel approximants force Hausdorff positivity of the
limit integer sequence.  No Zhang or other literature theorem is used. -/
theorem XI_FINITE_KERNEL_APPROX_TO_SEQUENCE_HAUSDORFF
    {c : ℕ → ℤ} (d : XiFiniteKernelApproxData c) :
    SequenceHausdorffPositive c := by
  intro n k
  obtain ⟨Y0, hY0⟩ := d.finiteJet (n + k)
  have hCoeff : ∀ j : ℕ, j ≤ n + k →
      weightedMoment (d.model Y0) (d.state Y0) j = (c j : ℝ) :=
    hY0 Y0 (Nat.le_refl Y0)
  have hCell :
      hdiff (weightedMoment (d.model Y0) (d.state Y0)) n k =
        hdiff (fun j => (c j : ℝ)) n k :=
    REAL_HDIFF_CONGR_UP_TO (n + k) n k hCoeff (Nat.le_refl (n + k))
  have hStage :
      0 ≤ hdiff (weightedMoment (d.model Y0) (d.state Y0)) n k :=
    weightedMoment_hausdorff_nonneg (d.model Y0) (d.state Y0) n k
  have hReal : 0 ≤ (HausdorffDiff c n k : ℝ) := by
    rw [← HDIFF_INT_CAST c n k, ← hCell]
    exact hStage
  have hInt : 0 ≤ HausdorffDiff c n k := by
    exact_mod_cast hReal
  refine ⟨Int.toNat (HausdorffDiff c n k), ?_⟩
  exact (Int.ofNat_toNat hInt).symm

/-- The actual Xi/Zhang coefficient sequence admits concrete finite Tier-A
kernel approximants.  This is the non-circular analytic calibration frontier. -/
def ActualXiFiniteKernelApproxAnchor : Prop :=
  Nonempty (XiFiniteKernelApproxData ZhangNormalizedCoeff)

/-- Concrete package: the five unconditional identities, actual completed
GolPhi/Xi equality, and only the explicit finite-kernel Xi calibration. -/
structure ActualXiConcreteTierAPackage : Prop where
  tierA : TierAFiveIdentityPackage
  actualXi : ActualCompletedGolPhiXiBinding
  calibration : ActualXiFiniteKernelApproxAnchor

/-- The unconditional fields add no logical strength to the concrete
calibration, but unlike the first atlas this wrapper contains no old RH-facing
anchor such as `OurFrontier`. -/
theorem ACTUAL_XI_CONCRETE_PACKAGE_IFF_CALIBRATION :
    ActualXiConcreteTierAPackage ↔ ActualXiFiniteKernelApproxAnchor := by
  constructor
  · intro h
    exact h.calibration
  · intro h
    exact ⟨CANONICAL_TIER_A_FIVE_IDENTITY_PACKAGE,
      ACTUAL_COMPLETED_GOLPHI_XI_BINDING, h⟩

/-- The concrete finite-kernel Xi calibration reaches the Zhang Hausdorff
landing without a literature theorem. -/
theorem ACTUAL_XI_FINITE_KERNEL_APPROX_TO_HAUSDORFF :
    ActualXiFiniteKernelApproxAnchor → HausdorffPositive := by
  intro h
  exact Nonempty.elim h XI_FINITE_KERNEL_APPROX_TO_SEQUENCE_HAUSDORFF

/-- Therefore the concrete package reaches Hausdorff positivity. -/
theorem ACTUAL_XI_CONCRETE_PACKAGE_TO_HAUSDORFF :
    ActualXiConcreteTierAPackage → HausdorffPositive := by
  intro h
  exact ACTUAL_XI_FINITE_KERNEL_APPROX_TO_HAUSDORFF h.calibration

/-- The concrete package also constructs the old strongest core frontier, but
only as a derived consequence of its explicit finite-kernel calibration. -/
theorem ACTUAL_XI_CONCRETE_PACKAGE_TO_OUR_FRONTIER :
    ActualXiConcreteTierAPackage → OurFrontier := by
  intro h
  exact HAUSDORFF_IFF_OUR_FRONTIER.mp
    (ACTUAL_XI_CONCRETE_PACKAGE_TO_HAUSDORFF h)

/-- Standard representation statement needed only for the reverse direction:
every Hausdorff-positive actual Xi sequence has exact finite positive-kernel
models for each finite jet.  This is a truncated Hausdorff/Tchakaloff-type
realization problem, not an RH assertion. -/
def TruncatedHausdorffFiniteKernelRealization : Prop :=
  HausdorffPositive → ActualXiFiniteKernelApproxAnchor

/-- Given the standard truncated realization theorem, the concrete package is
exactly equivalent to the Hausdorff landing. -/
theorem HAUSDORFF_IFF_ACTUAL_XI_CONCRETE_PACKAGE
    (hRealize : TruncatedHausdorffFiniteKernelRealization) :
    HausdorffPositive ↔ ActualXiConcreteTierAPackage := by
  constructor
  · intro hH
    exact ACTUAL_XI_CONCRETE_PACKAGE_IFF_CALIBRATION.mpr (hRealize hH)
  · exact ACTUAL_XI_CONCRETE_PACKAGE_TO_HAUSDORFF

end GPBKQRAnchoring01
