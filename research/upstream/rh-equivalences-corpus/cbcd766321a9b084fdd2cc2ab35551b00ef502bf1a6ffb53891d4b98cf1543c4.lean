import TierA.AlgebraicPascal

namespace GPBKQRTierA

open scoped BigOperators

/-- Canonical positive semidefinite scalar product attached to an explicit
finite probability model.  Degenerate zero-weight coordinates are allowed;
no quotient or positivity hypothesis is needed for the identities below. -/
def weightedInner {d : ℕ} (P : FiniteProbability d)
    (f g : Fin d → ℝ) : ℝ :=
  ∑ i, P.weight i * f i * g i

/-- Hermitian symmetry in the real finite kernel model. -/
theorem weightedInner_symm {d : ℕ} (P : FiniteProbability d)
    (f g : Fin d → ℝ) :
    weightedInner P f g = weightedInner P g f := by
  unfold weightedInner
  apply Finset.sum_congr rfl
  intro i hi
  ring

/-- The finite scalar product is positive semidefinite by construction. -/
theorem weightedInner_self_nonneg {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) :
    0 ≤ weightedInner P f f := by
  unfold weightedInner
  apply Finset.sum_nonneg
  intro i hi
  have h := mul_nonneg (P.weight_nonneg i) (sq_nonneg (f i))
  simpa [pow_two, mul_assoc] using h

/-- Pointwise multiplication by the finite contraction coordinate. -/
def nodePower {d : ℕ} (P : FiniteProbability d)
    (n : ℕ) (f : Fin d → ℝ) : Fin d → ℝ :=
  fun i => ((P.node i : ℝ) ^ n) * f i

@[simp] theorem nodePower_zero {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) :
    nodePower P 0 f = f := by
  funext i
  simp [nodePower]

/-- The contraction powers form an exact multiplicative semigroup. -/
theorem nodePower_add {d : ℕ} (P : FiniteProbability d)
    (n m : ℕ) (f : Fin d → ℝ) :
    nodePower P n (nodePower P m f) = nodePower P (n + m) f := by
  funext i
  simp [nodePower, pow_add, mul_assoc]

/-- Kernel-valued Bernstein/Pascal cell. -/
def weightedCellForm {d : ℕ} (P : FiniteProbability d)
    (n k : ℕ) (f g : Fin d → ℝ) : ℝ :=
  ∑ i, P.weight i * bernsteinCell (P.node i) n k * f i * g i

/-- Symmetry of every kernel-valued Pascal cell. -/
theorem weightedCellForm_symm {d : ℕ} (P : FiniteProbability d)
    (n k : ℕ) (f g : Fin d → ℝ) :
    weightedCellForm P n k f g = weightedCellForm P n k g f := by
  unfold weightedCellForm
  apply Finset.sum_congr rfl
  intro i hi
  ring

/-- Every diagonal kernel cell is nonnegative. -/
theorem weightedCellForm_diag_nonneg {d : ℕ} (P : FiniteProbability d)
    (n k : ℕ) (f : Fin d → ℝ) :
    0 ≤ weightedCellForm P n k f f := by
  unfold weightedCellForm
  apply Finset.sum_nonneg
  intro i hi
  have hwc : 0 ≤ P.weight i * bernsteinCell (P.node i) n k :=
    mul_nonneg (P.weight_nonneg i) (bernsteinCell_nonneg (P.node i) n k)
  have h := mul_nonneg hwc (sq_nonneg (f i))
  simpa [pow_two, mul_assoc] using h

/-- Exact kernel-valued Pascal split, derived pointwise from `x + (1-x)=1`. -/
theorem weightedCellForm_split {d : ℕ} (P : FiniteProbability d)
    (n k : ℕ) (f g : Fin d → ℝ) :
    weightedCellForm P n k f g =
      weightedCellForm P (n + 1) k f g +
        weightedCellForm P n (k + 1) f g := by
  unfold weightedCellForm
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  rw [bernsteinCell_split]
  ring

/-- Vector energy generated by the finite positive kernel. -/
def weightedEnergy {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) (n k : ℕ) : ℝ :=
  weightedCellForm P n k f f

/-- Boundary moment sequence of an arbitrary finite vector. -/
def weightedMoment {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) (n : ℕ) : ℝ :=
  weightedEnergy P f n 0

/-- Every kernel energy is nonnegative. -/
theorem weightedEnergy_nonneg {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) (n k : ℕ) :
    0 ≤ weightedEnergy P f n k :=
  weightedCellForm_diag_nonneg P n k f

/-- The vector energy obeys the exact Pascal split. -/
theorem weightedEnergy_split {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) (n k : ℕ) :
    weightedEnergy P f n k =
      weightedEnergy P f (n + 1) k +
        weightedEnergy P f n (k + 1) :=
  weightedCellForm_split P n k f f

/-- Signed Hausdorff differences of every finite-vector moment sequence are
exactly its explicit positive kernel energies. -/
theorem hdiff_weightedMoment_eq_energy {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) :
    ∀ n k, hdiff (weightedMoment P f) n k = weightedEnergy P f n k := by
  intro n k
  induction k generalizing n with
  | zero => rfl
  | succ k ih =>
      rw [hdiff_succ, ih n, ih (n + 1)]
      have hs := weightedEnergy_split P f n k
      linarith

/-- Every vector in the finite kernel model generates a Hausdorff-positive
moment sequence. -/
theorem weightedMoment_hausdorff_nonneg {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) (n k : ℕ) :
    0 ≤ hdiff (weightedMoment P f) n k := by
  rw [hdiff_weightedMoment_eq_energy]
  exact weightedEnergy_nonneg P f n k

/-- Monomial feature map of the finite kernel. -/
def monomialFeature {d : ℕ} (P : FiniteProbability d)
    (n : ℕ) : Fin d → ℝ :=
  fun i => (P.node i : ℝ) ^ n

/-- Explicit Gram kernel generated by the monomial features. -/
def finiteGramKernel {d : ℕ} (P : FiniteProbability d)
    (n m : ℕ) : ℝ :=
  weightedInner P (monomialFeature P n) (monomialFeature P m)

/-- The Gram-kernel entries are exactly the finite moments. -/
theorem finiteGramKernel_eq_moment {d : ℕ} (P : FiniteProbability d)
    (n m : ℕ) :
    finiteGramKernel P n m = finiteMoment P (n + m) := by
  unfold finiteGramKernel weightedInner monomialFeature finiteMoment
  apply Finset.sum_congr rfl
  intro i hi
  rw [pow_add]
  ring

/-- Symmetry of the explicit Gram kernel. -/
theorem finiteGramKernel_symm {d : ℕ} (P : FiniteProbability d)
    (n m : ℕ) :
    finiteGramKernel P n m = finiteGramKernel P m n := by
  rw [finiteGramKernel_eq_moment, finiteGramKernel_eq_moment, Nat.add_comm]

/-- Nonnegativity of every diagonal Gram-kernel entry. -/
theorem finiteGramKernel_diag_nonneg {d : ℕ} (P : FiniteProbability d)
    (n : ℕ) :
    0 ≤ finiteGramKernel P n n := by
  exact weightedInner_self_nonneg P (monomialFeature P n)

/-- Feature-space linear combination used to state Gram positivity without
postulating any matrix-positivity axiom. -/
def finiteKernelCombination {d N : ℕ} (P : FiniteProbability d)
    (c : Fin N → ℝ) : Fin d → ℝ :=
  fun i => ∑ j, c j * (P.node i : ℝ) ^ (j : ℕ)

/-- Gram positivity for every finite coefficient family, derived as a weighted
sum of squares. -/
theorem finiteGramKernel_psd {d N : ℕ} (P : FiniteProbability d)
    (c : Fin N → ℝ) :
    0 ≤ weightedInner P (finiteKernelCombination P c)
      (finiteKernelCombination P c) :=
  weightedInner_self_nonneg P (finiteKernelCombination P c)

/-- Left branch of the canonical binary Hilbert lift. -/
noncomputable def binaryLeft {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) : Fin d → ℝ :=
  fun i => Real.sqrt (P.node i : ℝ) * f i

/-- Right/defect branch of the canonical binary Hilbert lift. -/
noncomputable def binaryRight {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) : Fin d → ℝ :=
  fun i => Real.sqrt (1 - (P.node i : ℝ)) * f i

/-- The canonical binary lift is an exact isometry for the finite kernel
scalar product. -/
theorem binary_weighted_conservation {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) :
    weightedInner P (binaryLeft P f) (binaryLeft P f) +
      weightedInner P (binaryRight P f) (binaryRight P f) =
        weightedInner P f f := by
  unfold weightedInner
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  have h := binary_square_conservation (P.node i) (f i)
  calc
    P.weight i * binaryLeft P f i * binaryLeft P f i +
        P.weight i * binaryRight P f i * binaryRight P f i
        = P.weight i *
            ((Real.sqrt (P.node i : ℝ) * f i) ^ 2 +
              (Real.sqrt (1 - (P.node i : ℝ)) * f i) ^ 2) := by
              simp [binaryLeft, binaryRight]
              ring
    _ = P.weight i * (f i) ^ 2 := by rw [h]
    _ = P.weight i * f i * f i := by ring

/-- The left branch is contractive, derived from exact binary conservation and
nonnegativity of the defect branch. -/
theorem binaryLeft_contract {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) :
    weightedInner P (binaryLeft P f) (binaryLeft P f) ≤
      weightedInner P f f := by
  have hsplit := binary_weighted_conservation P f
  have hright := weightedInner_self_nonneg P (binaryRight P f)
  linarith

/-- The right branch is contractive for the same reason. -/
theorem binaryRight_contract {d : ℕ} (P : FiniteProbability d)
    (f : Fin d → ℝ) :
    weightedInner P (binaryRight P f) (binaryRight P f) ≤
      weightedInner P f f := by
  have hsplit := binary_weighted_conservation P f
  have hleft := weightedInner_self_nonneg P (binaryLeft P f)
  linarith

end GPBKQRTierA
